SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Kunci Rahasia Admin (dikirim via header x-admin-key)
ADMIN_KEY=bloom-admin-2026

# URL Frontend untuk pembatasan CORS
FRONTEND_URL=http://localhost:5173

# Informasi Rekening Pembayaran (ditampilkan melalui GET /api/config)
BANK_NAME=BCA
BANK_ACCOUNT=8720194821
BANK_HOLDER=PT Bloom Florist Nusantara

# Informasi Toko Pengambilan Pesanan (ditampilkan melalui GET /api/config)
STORE_NAME=Bloom & Co. Botanical Atelier
STORE_ADDRESS=Jl. Prof. Sudarto No. 12, Tembalang, Semarang
STORE_OPEN_TIME=08:00

# Port Server Lokal
PORT=3000
